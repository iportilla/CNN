# Copy to .env and fill in. Never commit .env.

# Lab 3 - Azure AI Vision (Computer Vision resource). Endpoint must end with "/".
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=https://<region>.api.cognitive.microsoft.com/

# Lab 4 - Azure Custom Vision (from the Prediction URL dialog)
CUSTOM_VISION_ENDPOINT=
CUSTOM_VISION_PREDICTION_KEY=
CUSTOM_VISION_PROJECT_ID=
CUSTOM_VISION_ITERATION=Iteration1

# Lab 5 - vision LLMs
VISION_MODELS=gemma3,llama3.2-vision
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Lab 6 - image generation
OPENAI_API_KEY=
